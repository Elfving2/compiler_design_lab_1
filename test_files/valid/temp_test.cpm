      for ( , cont , cont := cont ) {

        for ( , true , cont := cont ) {
          i := i + 1
          aux := number[i]
          if (!(aux < v)) break
        }

        for ( , true , cont := cont ) {
          j := j - 1
          aux := number[j]
          if (!(v < aux)) break
        }

        t := number[i]
        number[i] := number[j]
        number[j] := t

        if (j < (i + 1)) cont := false
      }

      number[j] := number[i]
      number[i] := number[right]
      number[right] := t
